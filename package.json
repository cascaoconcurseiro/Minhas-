    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-bancos": "0.11.0",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },

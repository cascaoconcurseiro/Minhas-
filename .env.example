# Optional. Enables live FX lookup and international ticker fallback through Gemini.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Neon/PostgreSQL — server only; never prefix with VITE_ and never expose in React.
# The runtime role must have only the grants in db/migrations/002_neon_app_role_grants.sql.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Login próprio: chave que assina as sessões (mín. 32 caracteres). Se ausente, o servidor
# deriva uma chave de DATABASE_URL. Gere com: openssl rand -hex 32
AUTH_SESSION_SECRET="troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres"

# Protege GET /api/readiness (Vercel Cron envia Authorization: Bearer <CRON_SECRET>).
CRON_SECRET="troque-por-um-segredo-aleatorio"

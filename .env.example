# Optional. Enables live FX lookup and international ticker fallback through Gemini.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Neon/PostgreSQL — server only; never prefix with VITE_ and never expose in React.
# The runtime role must have only the grants in db/migrations/002_neon_app_role_grants.sql.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Firebase Auth — identity only; the app does not use Firestore.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_API_KEY="your-firebase-web-api-key"
